{
  "inputs": [
    {
      "description": "Azure Agent Tool Server: connector-api-key",
      "id": "azure-connector-api-key",
      "password": true,
      "type": "promptString"
    },
    {
      "description": "Azure Agent Tool Server MCP endpoint",
      "id": "azure-endpoint",
      "type": "promptString"
    }
  ],
  "servers": {
    "ast-summarizer": {
      "args": [
        "-y",
        "@agent-tool-platform/ast-summarizer@0.1.1"
      ],
      "command": "npx",
      "type": "stdio"
    },
    "azure": {
      "headers": {
        "x-api-key": "${input:azure-connector-api-key}"
      },
      "type": "http",
      "url": "${input:azure-endpoint}"
    },
    "data-cruncher": {
      "args": [
        "--offline",
        "agent-tool-server-data-cruncher@0.0.0-development"
      ],
      "command": "npx",
      "type": "stdio"
    },
    "doc-rag": {
      "args": [
        "--offline",
        "agent-tool-server-doc-rag@0.0.0-development"
      ],
      "command": "npx",
      "type": "stdio"
    },
    "document-optimizer": {
      "args": [
        "--offline",
        "agent-tool-server-document-optimizer@0.0.0-development"
      ],
      "command": "npx",
      "type": "stdio"
    },
    "git-optimizer": {
      "args": [
        "--offline",
        "agent-tool-server-git-optimizer@0.1.0"
      ],
      "command": "npx",
      "type": "stdio"
    },
    "vision": {
      "args": [
        "--offline",
        "agent-tool-server-vision@0.0.0-development"
      ],
      "command": "npx",
      "type": "stdio"
    }
  }
}
